# API Settings
TASKFORGE_APP_NAME=taskforge
TASKFORGE_ENVIRONMENT=development
TASKFORGE_DEBUG=false
TASKFORGE_API_HOST=0.0.0.0
TASKFORGE_API_PORT=8000
TASKFORGE_API_KEY=your-secure-api-key-here

# Database Settings
TASKFORGE_POSTGRES_HOST=localhost
TASKFORGE_POSTGRES_PORT=5432
TASKFORGE_POSTGRES_USER=postgres
TASKFORGE_POSTGRES_PASSWORD=password
TASKFORGE_POSTGRES_DB=taskforge
TASKFORGE_POSTGRES_MIN_CONNECTIONS=5
TASKFORGE_POSTGRES_MAX_CONNECTIONS=20
TASKFORGE_POSTGRES_CONNECTION_RETRY=3
TASKFORGE_POSTGRES_RETRY_INTERVAL=5

# RabbitMQ Settings
TASKFORGE_RABBITMQ_HOST=localhost
TASKFORGE_RABBITMQ_PORT=5672
TASKFORGE_RABBITMQ_USER=guest
TASKFORGE_RABBITMQ_PASSWORD=guest
TASKFORGE_RABBITMQ_VHOST=/
TASKFORGE_RABBITMQ_CONNECTION_RETRY=3
TASKFORGE_RABBITMQ_RETRY_INTERVAL=5

# Redis Settings
TASKFORGE_REDIS_HOST=localhost
TASKFORGE_REDIS_PORT=6379
TASKFORGE_REDIS_DB=0
TASKFORGE_REDIS_PASSWORD=
TASKFORGE_REDIS_POOL_SIZE=10

# Worker Settings
TASKFORGE_WORKER_COUNT=4
TASKFORGE_WORKER_PREFETCH_COUNT=10
TASKFORGE_WORKER_MAX_MEMORY_MB=512
TASKFORGE_WORKER_CPU_LIMIT=1.0

# Job Processing
TASKFORGE_MAX_JOB_TIMEOUT=3600
TASKFORGE_DEFAULT_JOB_TIMEOUT=300
TASKFORGE_JOB_RETENTION_DAYS=7
TASKFORGE_MAX_RETRIES=3
TASKFORGE_MESSAGE_TTL=86400
TASKFORGE_DEAD_LETTER_EXCHANGE=taskforge.dlx

# Monitoring
TASKFORGE_LOG_LEVEL=INFO
TASKFORGE_JSON_LOGS=true
TASKFORGE_ENABLE_TRACING=true
TASKFORGE_JAEGER_HOST=localhost
TASKFORGE_JAEGER_PORT=6831
